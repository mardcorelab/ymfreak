# Copy to .env.local (never commit real values).

# ── Phase 0 ──────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/ymfreak"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Phase 2 · Dashboard sign-in ──────────────────────
# The dashboard (/dashboard) stays closed until both are set.
ADMIN_EMAIL=""
# At least 12 characters. Changing it signs you out everywhere.
ADMIN_PASSWORD=""
# Optional: session signing secret (32+ chars). Derived from ADMIN_PASSWORD if empty.
AUTH_SECRET=""
RESEND_API_KEY=""
EMAIL_FROM=""

# ── Phase 4 · PayPal (developer.paypal.com → Apps & Credentials) ──
# "sandbox" for test payments, "live" for real money (use the matching credentials).
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Webhook URL: https://<your-domain>/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=""

# ── Phase 5 · Assistant ──────────────────────────────
ANTHROPIC_API_KEY=""
# Optional: model for the assistant (default claude-sonnet-5-5)
ANTHROPIC_MODEL=""

# ── Phase 7 · Rate limiting / anti-spam ─────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
TURNSTILE_SECRET_KEY=""

# Optional: song.link (Odesli) API key — finds each release on every platform automatically
SONGLINK_API_KEY=""

# Optional: YouTube Data API v3 key — real view counts of the releases on YouTube
YOUTUBE_API_KEY=""
