# Copy to .env.local (never commit real values).

# ── Phase 0 ──────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/ymfreak"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Phase 2 · Auth ───────────────────────────────────
# Generate with: openssl rand -base64 32
