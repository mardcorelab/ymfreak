# Copy to .env.local (never commit real values).

# ── Phase 0 ──────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/ymfreak"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Phase 2 · Dashboard sign-in ──────────────────────
# The dashboard (/dashboard) stays closed until both are set.
ADMIN_EMAIL=""
# At least 12 characters. Changing it signs you out everywhere.
ADMIN_PASSWORD=""
# Optional: session signing secret (32+ chars). Derived from ADMIN_PASSWORD if empty.
AUTH_SECRET=""
RESEND_API_KEY=""
EMAIL_FROM=""

# ── Phase 4 · PayPal (developer.paypal.com → Apps & Credentials) ──
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# ── Phase 5 · Assistant ──────────────────────────────
ANTHROPIC_API_KEY=""

# ── Phase 7 · Rate limiting / anti-spam ─────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
TURNSTILE_SECRET_KEY=""
